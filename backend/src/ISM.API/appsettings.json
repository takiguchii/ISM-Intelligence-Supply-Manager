{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=ism;User=ism;Password=ism;"
  },
  "Database": {
    "Provider": "MySql"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://frontend:3000"
    ]
  },
  "Jwt": {
    "Issuer": "ISM",
    "Audience": "ISM.Users",
    "SecretKey": "SUPER_SECRET_KEY_FOR_DEVELOPMENT_ONLY_CHANGE_IN_PRODUCTION_PLEASE_123456",
    "ExpiresInMinutes": 1440
  },
  "PhotoImport": {
    "Provider": "OpenAICompatible",
    "ApiEndpoint": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "MaxFileSizeMb": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
