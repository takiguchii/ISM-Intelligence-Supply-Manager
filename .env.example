COMPOSE_PROJECT_NAME=ism
# Atualizado por scripts/sync-branch-db.sh; não edite manualmente.
ISM_BRANCH_SLUG=hotfix-admin-foundation-hardening
BACKEND_PORT=8080
FRONTEND_PORT=3000
MYSQL_PORT=3306
MYSQL_DATABASE=ism
MYSQL_USER=ism
MYSQL_PASSWORD=ism
MYSQL_ROOT_PASSWORD=root
SEED_DEMO_DATA=false
# Em Development, defina true e informe uma senha local para criar os quatro usuários de teste.
# Nunca versione valores reais.
SEED_PASSWORD=
NUXT_API_BASE=http://backend:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000


# Envio externo: deixar desativado até configurar as contas reais.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# StartTls (587), SslOnConnect (465); None somente para SMTP local de testes.
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ISM

# WhatsApp por QR Code (serviço opcional em docker-compose.whatsapp.yml).
WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=http://whatsapp:3000
WHATSAPP_API_KEY=
WHATSAPP_SESSION=default
WHATSAPP_PORT=3001
WHATSAPP_DASHBOARD_USERNAME=ism
WHATSAPP_DASHBOARD_PASSWORD=
